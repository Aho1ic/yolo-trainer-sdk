# ===========================================
# Trainer V3 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ===========================================

# MySQL数据库配置
TRAINER_DB_HOST=localhost
TRAINER_DB_PORT=3306
TRAINER_DB_USER=your_db_user
TRAINER_DB_PASSWORD=your_db_password
TRAINER_DB_NAME=algorithm_trainer1
TRAINER_DB_CHARSET=utf8mb4

# 训练相关配置
TRAINER_LOG_LEVEL=INFO
TRAINER_MAX_CONCURRENT_TASKS=5
TRAINER_MODEL_PRELOAD=false

# RustFS/MinIO对象存储配置
TRAINER_MINIO_ENDPOINT=localhost:9001
TRAINER_MINIO_ACCESS_KEY=your_access_key
TRAINER_MINIO_SECRET_KEY=your_secret_key
TRAINER_MINIO_SECURE=false
TRAINER_MINIO_BUCKET=algorithm
TRAINER_MINIO_BASE_PATH=trainer

# 对象存储本地工作区配置
TRAINER_STORAGE_CACHE_ROOT=/data/trainer_work

# Redis配置
TRAINER_REDIS_HOST=localhost
TRAINER_REDIS_PORT=6379
TRAINER_REDIS_DATABASE=11
TRAINER_REDIS_PASSWORD=your_redis_password
