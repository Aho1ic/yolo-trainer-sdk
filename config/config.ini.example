[trainer_config]
; MySQL数据库配置
db_host = localhost
db_port = 3306
db_user = your_db_user
db_passwd = your_db_password
db_db = algorithm_trainer1
db_charset = utf8mb4

; 训练相关配置
log_level = INFO
max_concurrent_tasks = 5
model_preload = false

; 本地数据根目录
data_root = /data/Sucai1/algorithm/trainer

; 数据处理完成回调地址（uav-server 基础地址，代码会拼接 /system/trainTask/open/process-callback）
process_callback_base_url = http://192.168.0.35:48080/admin-api

; Redis配置
redis_host = localhost
redis_port = 6379
redis_database = 11
redis_password = your_redis_password
