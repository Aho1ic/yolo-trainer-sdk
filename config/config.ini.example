[trainer_config]
; MySQL数据库配置
db_host = localhost
db_port = 3306
db_user = your_db_user
db_passwd = your_db_password
db_db = algorithm_trainer1
db_charset = utf8mb4

; 训练相关配置
log_level = INFO
max_concurrent_tasks = 5
model_preload = false

; RustFS对象存储配置
minio_endpoint = localhost:9001
minio_access_key = your_access_key
minio_secret_key = your_secret_key
minio_secure = false
minio_bucket = algorithm
minio_base_path = trainer

; 对象存储本地工作区配置
object_storage_cache_root = /data/trainer_work

; Redis配置
redis_host = localhost
redis_port = 6379
redis_database = 11
redis_password = your_redis_password
